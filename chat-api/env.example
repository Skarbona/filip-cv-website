# Copy to chat-api/.env for local runs (.env files are gitignored). Never commit real keys.
# Without the keys the API still runs: canned answers, and contact messages printed to the console.

OPENROUTER_API_KEY=
RESEND_API_KEY=

# Optional, these are the defaults
# OPENROUTER_MODELS=deepseek/deepseek-v4-flash
# OPENROUTER_DATA_COLLECTION=deny
# CONTACT_TO=filip.sokolowski1990@gmail.com
# CONTACT_FROM=Filip's AI chat <chat@filip-sokolowski.pl>
# PORT=3001
# ALLOWED_ORIGIN=http://localhost:3000
# CHAT_PER_MINUTE=8
# CHAT_PER_DAY=60
# CHAT_GLOBAL_PER_DAY=2000
# CONTACT_PER_DAY=3
# CONTACT_GLOBAL_PER_DAY=30
